#installing neccessary packages
install.packages("adegenet", dep=TRUE)
install.packages("phangorn", dep=TRUE)

#loading packages
library(ape)
library(adegenet)
library(phangorn)

#distance-based tree

#loading sample data and convert to phangorn object
dna <- fasta2DNAbin(file="~/Documents/plpath563/data/alignment_results/MAFFT_aligned.fasta")


#computing genetic distances
D <- dist.dna(dna, model="TN93")

#getting NJ tree
tre <- nj(D)


#ladderize
tre <- ladderize(tre)

#plot tree
plot(tre, cex=.6)
title("NJ tree")


#parsimony-based tree

#reformat
dna2 <- as.phyDat(dna)

#starting tree (NJ tree)
starting_tree <- tre


#NJ tree to parisomony tree
parsimony_tree <- optim.parsimony(starting_tree, dna2)


#plot tree
plot(parsimony_tree)
title("Parsimony Tree")






